# AWS Configuration
AWS_REGION=your-aws-region

# Knowledge Base Query Lambda Function URL
# This is the Lambda Function URL for the RetrieveAndGenerate API endpoint
NEXT_PUBLIC_KB_FUNCTION_URL=https://your-kb-function-url.lambda-url.your-aws-region.on.aws/

# Document Upload Lambda Function URL
# This is the Lambda Function URL for the upload-document endpoint
NEXT_PUBLIC_UPLOAD_FUNCTION_URL=https://your-upload-function-url.lambda-url.your-aws-region.on.aws/
